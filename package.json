{
  "name": "worthlookingup",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "python3 -m http.server 8787",
    "test": "node scripts/test-science.cjs",
    "test:browser": "playwright test",
    "build": "node scripts/build.cjs",
    "check": "node tests/migration.cjs",
    "launches:refresh": "node scripts/refresh-launches.mjs",
    "launches:check": "node scripts/refresh-launches.mjs --check",
    "deploy": "npm run build && wrangler pages deploy dist --project-name worthlookingup --branch main",
    "geodata:candidates": "node research/geodata/tools/fetch-candidates.mjs",
    "geodata:profiles": "node research/geodata/tools/build-profiles.mjs",
    "geodata:report": "node research/geodata/tools/build-report.mjs",
    "geodata:fixture": "node research/geodata/tools/make-fixture.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "ical.js": "2.2.1",
    "wrangler": "4.151.0"
  }
}
